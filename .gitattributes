# Run on Linux, in packages and containers: Unix line endings, whatever the
# checkout they were written in.
*.sh text eol=lf
packaging/** text eol=lf
docker/** text eol=lf
.dockerignore text eol=lf
# Rewritten by the Tauri build with Unix line endings: kept that way, so a
# build leaves the tree clean and its commit stamp has no "+".
apps/*/src-tauri/Cargo.toml text eol=lf
apps/client/src-tauri/plugins/basalt-android/permissions/** text eol=lf
