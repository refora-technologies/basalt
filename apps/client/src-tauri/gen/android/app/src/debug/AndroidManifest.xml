<?xml version="1.0" encoding="utf-8"?>
<!--
  Test builds only, merged over the main manifest for debug builds: Android
  16's stand-in for Android 17's local network permission, so the way the app
  asks for it can be tried on Android 16 with
  `adb shell am compat enable RESTRICT_LOCAL_NETWORK <package>`.
  See LocalNetwork.kt in the basalt-android plugin. Never in a release.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />
</manifest>
