{
  "$schema": "https://schema.tauri.app/config/2",
  "mainBinaryName": "basalt",
  "app": {
    "windows": [
      {
        "title": "Basalt",
        "width": 1280,
        "height": 820,
        "minWidth": 880,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "theme": "Dark",
        "backgroundColor": "#00000000",
        "dragDropEnabled": true
      }
    ]
  },
  "bundle": {
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "resources": [],
    "linux": {
      "deb": {
        "depends": [
          "libmpv2 | libmpv1",
          "ca-certificates"
        ],
        "files": {
          "/usr/share/kio/servicemenus/basalt-share.desktop": "linux/basalt-share-kde.desktop",
          "/usr/share/kservices5/ServiceMenus/basalt-share.desktop": "linux/basalt-share-kde.desktop",
          "/usr/share/nemo/actions/basalt-share.nemo_action": "linux/basalt-share.nemo_action"
        }
      },
      "rpm": {
        "depends": [
          "mpv-libs",
          "ca-certificates"
        ],
        "files": {
          "/usr/share/kio/servicemenus/basalt-share.desktop": "linux/basalt-share-kde.desktop",
          "/usr/share/kservices5/ServiceMenus/basalt-share.desktop": "linux/basalt-share-kde.desktop",
          "/usr/share/nemo/actions/basalt-share.nemo_action": "linux/basalt-share.nemo_action"
        }
      }
    }
  }
}
