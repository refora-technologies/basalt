{
  "$schema": "https://schema.tauri.app/config/2",
  "mainBinaryName": "basalt-host",
  "app": {
    "windows": [
      {
        "title": "Basalt Host",
        "width": 1040,
        "height": 740,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "theme": "Dark",
        "backgroundColor": "#00000000",
        "dragDropEnabled": false,
        "visible": true
      }
    ]
  },
  "bundle": {
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "resources": [],
    "linux": {
      "deb": {
        "recommends": [
          "ffmpeg",
          "libmpv2"
        ],
        "files": {
          "/etc/ufw/applications.d/basalt-host": "linux/basalt-host.ufw",
          "/usr/lib/basalt-host/basalt-host-update": "linux/basalt-host-update",
          "/usr/share/polkit-1/actions/com.reforatech.basalt.host.update.policy": "linux/com.reforatech.basalt.host.update.policy"
        },
        "depends": [
          "ca-certificates"
        ]
      },
      "rpm": {
        "recommends": [
          "ffmpeg",
          "mpv-libs"
        ],
        "files": {
          "/usr/lib/firewalld/services/basalt-host.xml": "linux/basalt-host.firewalld.xml",
          "/usr/lib/basalt-host/basalt-host-update": "linux/basalt-host-update",
          "/usr/share/polkit-1/actions/com.reforatech.basalt.host.update.policy": "linux/com.reforatech.basalt.host.update.policy"
        },
        "depends": [
          "ca-certificates"
        ]
      }
    }
  }
}
