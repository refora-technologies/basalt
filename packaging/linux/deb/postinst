#!/bin/sh
# Basalt Host (no screen): after installing or upgrading.
set -e

if [ "$1" = "configure" ]; then
    # The host's own user: no login, no home but its settings folder.
    if ! getent passwd basalt >/dev/null 2>&1; then
        useradd --system --user-group --no-create-home \
            --home-dir /var/lib/basalt-host --shell /usr/sbin/nologin \
            --comment "Basalt Host" basalt
    fi

    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload >/dev/null 2>&1 || true
        systemctl enable basalt-host.service >/dev/null 2>&1 || true
        systemctl restart basalt-host.service >/dev/null 2>&1 || true
    fi

    if [ -z "$2" ]; then
        cat <<'EOF'

  Basalt Host is running.

  To set it up, open Basalt on your phone or computer, on this network, and
  choose this host. It asks for the setup code, which this shows:

      sudo basalt-host setup-code

  Give it access to the folders it shares: see /usr/share/doc/basalt-host-server/README.md

EOF
        # A firewall that is on keeps every device out, and a host with no
        # screen has nowhere to say so. Not opened here: that is the
        # computer owner's call.
        if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -q "Status: active"; then
            cat <<'EOF'
  The firewall (ufw) is on. Let your devices reach the host:

      sudo ufw allow "Basalt Host"

EOF
        elif command -v firewall-cmd >/dev/null 2>&1 && firewall-cmd --state >/dev/null 2>&1; then
            cat <<'EOF'
  The firewall (firewalld) is on. Let your devices reach the host:

      sudo firewall-cmd --permanent --add-service=basalt-host
      sudo firewall-cmd --reload

EOF
        fi
    fi
fi

exit 0
